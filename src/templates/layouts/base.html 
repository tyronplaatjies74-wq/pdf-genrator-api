<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{title}}</title>
<style>
  @page { size: A4; margin: 18mm 16mm; }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { font-family: "Helvetica Neue", Helvetica, Arial, "Liberation Sans", sans-serif; font-size: 11pt; color: #1f2933; line-height: 1.45; margin: 0; }
  h1, h2, h3 { margin: 0; line-height: 1.2; }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; font-size: 9pt; text-transform: uppercase; letter-spacing: .05em; color: #616e7c; border-bottom: 2px solid #cbd2d9; padding: 8px 6px; }
  td { padding: 8px 6px; border-bottom: 1px solid #e4e7eb; vertical-align: top; }
  .right { text-align: right; }
  .muted { color: #616e7c; }
  .row { display: flex; justify-content: space-between; gap: 24px; }
  tr, .no-break { page-break-inside: avoid; }
</style>
</head>
<body>
{{{body}}}
</body>
</html>